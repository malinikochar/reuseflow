# Public-safe Supabase config — replace with your actual project values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_ENABLED=true

# Optional Resend P1 — server-only. Never commit real keys.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
REPORT_RECIPIENT_ALLOWLIST=

# Only if your chosen backend integration needs a privileged server-only key.
# SUPABASE_SECRET_KEY=
